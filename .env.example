# Copy to .env and fill in your own values.
#
# Every id below is a placeholder. There is no real project, engine, dataset or
# glossary id anywhere in this repository's source or in this template: the
# backend raises on an unset value rather than defaulting to one, because a
# default is how a misconfigured run looks healthy while reading somebody
# else's data.

GOOGLE_GENAI_USE_VERTEXAI=true

# Required. No default in code.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Required. The numeric id of your Vertex AI Agent Engine, which resolves to
#   projects/<your-project>/locations/<location>/reasoningEngines/<this-id>
#
# Create one (there is no gcloud subcommand for this yet):
#   curl -s -X POST \
#     -H "Authorization: Bearer $(gcloud auth application-default print-access-token)" \
#     -H "Content-Type: application/json" \
#     -d '{"displayName": "your-engine-display-name"}' \
#     "https://us-central1-aiplatform.googleapis.com/v1beta1/projects/your-gcp-project-id/locations/us-central1/reasoningEngines"
VERTEX_AGENT_ENGINE_ID=000000000000000000
AGENT_ENGINE_ID=000000000000000000

# Required. BigQuery dataset and Dataplex glossary. Set both spellings of each:
# backend/app.py reads the first, the demo kit's scripts/config.sh reads the
# second, and they must agree.
BIGQUERY_DATASET=your_bigquery_dataset
BQ_DATASET=your_bigquery_dataset
DATAPLEX_GLOSSARY=your-glossary-id
DATAPLEX_GLOSSARY_ID=your-glossary-id

# Optional.
GEMINI_MODEL=gemini-2.5-flash
PORT=5055

# Optional. Ids of the rows the UI opens on, in your seeded dataset.
DEMO_CUSTOMER_ID=CUST00001
DEMO_DEBIT_CARD_ID=CARD00004
DEMO_CREDIT_CARD_ID=CARD00002
DEMO_DEBIT_DISPUTE_ID=DSP00033
DEMO_CREDIT_DISPUTE_ID=DSP00034

# Optional. A separate Agent Engine for eval runs, so volume and noise tests
# never touch demo memories. Create it with scripts/create_eval_engine.py.
VERTEX_EVAL_AGENT_ENGINE_ID=000000000000000000
