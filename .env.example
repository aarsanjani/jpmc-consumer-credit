# Copy this file to `.env` and replace every value with your own.
#
# Every value below is a placeholder. The application does NOT fall back to a
# default for any of them: `backend/config.py::require_env` raises
# ConfigurationError if a variable is missing, rather than quietly substituting
# a demo value. That is deliberate — a missing credential should stop the
# process, not produce a plausible-looking but fabricated answer.

# --- Model access -----------------------------------------------------------
# Must be `true`. The repository uses the `google-genai` SDK against Vertex AI.
# Never set GOOGLE_API_KEY and never import `google.generativeai` (see GEMINI.md).
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Google Cloud project ---------------------------------------------------
# The project id (the human-readable one, e.g. `my-team-sandbox`).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# The project NUMBER (all digits). Vertex AI echoes the project number back in
# resource names such as `projects/<number>/locations/.../memories/<id>`, and
# Dataplex aspect keys are prefixed `<number>.<location>.<aspect-type>`. Supply
# it so resource names and aspect keys match what the services actually return.
GOOGLE_CLOUD_PROJECT_NUMBER=000000000000

# Region for Vertex AI, Agent Engine and Dataplex. Memory Bank is not available
# in every region; us-central1 is a safe choice.
GOOGLE_CLOUD_LOCATION=us-central1

# --- Vertex AI Agent Engine (Memory Bank) -----------------------------------
# The numeric id of your Agent Engine, i.e. the last path segment of
# `projects/<number>/locations/<location>/reasoningEngines/<id>`.
# Create one with `gcloud alpha aiplatform reasoning-engines create`, or via the
# REST API described in docs/MEMORY_BANK_EVIDENCE.md.
VERTEX_AGENT_ENGINE_ID=000000000000000000

# --- BigQuery ---------------------------------------------------------------
# The dataset holding the warehouse tables the agent reads as ground truth.
# Both spellings are accepted; set whichever you prefer.
BIGQUERY_DATASET=your_dataset_id
BQ_DATASET=your_dataset_id

# --- Dataplex Universal Catalog --------------------------------------------
# The glossary id that holds the business vocabulary and the aspect types used
# for governance decisions. Both spellings are accepted.
DATAPLEX_GLOSSARY=your-glossary-id
DATAPLEX_GLOSSARY_ID=your-glossary-id

# --- Local server -----------------------------------------------------------
PORT=5000
